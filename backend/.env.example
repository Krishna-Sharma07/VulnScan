ENVIRONMENT=development

# Required - the app refuses to start without these (see app/core/secrets.py).
# SECRETS_PROVIDER selects where they're read from; only "env" (read straight
# from these variables) is implemented today, so leave it unset or "env"
# until a real secrets manager/KMS is wired up.
# SECRETS_PROVIDER=env
SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_COOKIE_ENCRYPTION_KEY=
DATABASE_URL=postgresql://vulnscan:vulnscan@localhost:5432/vulnscan
REDIS_URL=redis://localhost:6379/0
DOCKER_SCANNER_IMAGE=vulnscan/zap-scanner:latest
